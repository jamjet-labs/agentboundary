{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentboundary.jamjet.dev/scenarios/_meta-schema.json",
  "title": "AgentBoundary scenario file",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "setup", "action", "expect"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "chain": ["receipt_version"] },
      "properties": {
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "rule", "capabilities"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "rule": {
                "type": "string",
                "enum": ["allow", "deny", "require-approval", "escalate"]
              },
              "capabilities": {
                "type": "array",
                "items": { "type": "string" }
              },
              "limit": {
                "type": "object",
                "required": ["field", "max"],
                "properties": {
                  "field": { "type": "string" },
                  "max": { "type": "number" }
                }
              },
              "approvers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "type"],
                  "properties": {
                    "id": { "type": "string" },
                    "type": { "type": "string" }
                  }
                }
              },
              "approval_max_age_seconds": { "type": "number", "minimum": 0 }
            }
          }
        },
        "prior_receipt_ids": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        },
        "seed_receipt_id": { "type": "string", "format": "uuid" },
        "receipt_version": {
          "type": "string",
          "enum": ["agentboundary/v0.1", "agentboundary/v0.2-alpha"],
          "description": "Receipt version the reference implementation emits. agentboundary/v0.2-alpha also turns on runtime enforcement of the approver list and approval window, and records refusals."
        },
        "envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kid", "seed_hex"],
          "description": "Sign the emitted receipt in a COSE_Sign1 envelope and verify it offline. seed_hex is a fixed TEST key, never a real one.",
          "properties": {
            "kid": { "type": "string", "minLength": 1 },
            "seed_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "issuer": { "type": "string", "minLength": 1 },
            "subject": { "type": "string", "minLength": 1 },
            "keyring_kid": {
              "type": "string",
              "minLength": 1,
              "description": "kid the verifier's keyring lists the key under (default: kid)."
            },
            "as_signed_statement": { "type": "boolean" }
          },
          "dependentRequired": {
            "issuer": ["subject"],
            "subject": ["issuer"]
          }
        },
        "now": {
          "type": "string",
          "format": "date-time",
          "description": "Pins the reference implementation's clock (issued_at, execution.completed_at) so time-window scenarios do not depend on when the suite runs."
        },
        "minimum_completeness": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "prior_receipt_hashes": {
          "type": "object",
          "description": "Map of receipt_id -> receipt_hash the verifier has on file; consulted for the v0.2-alpha LEVEL_4_BROKEN_CHAIN check.",
          "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "prior_approvals": {
          "type": "array",
          "description": "Approvals the verifier has already seen used, each with the receipt_hash of the receipt that used it. Consulted for LEVEL_4_APPROVAL_REPLAY.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approval", "receipt_hash"],
            "properties": {
              "approval": {
                "type": "object",
                "description": "The approval block as a receipt records it."
              },
              "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "chain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length"],
          "description": "Build a chain of receipts ending in a copy of this scenario's receipt, linked with prior_receipt and signed when setup.envelope is set, apply the injects, and verify it offline. Needs receipt_version agentboundary/v0.2-alpha.",
          "properties": {
            "length": { "type": "integer", "minimum": 2, "maximum": 8 },
            "inject": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["op", "index"],
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "type": "string",
                    "enum": [
                      "edit_and_rehash",
                      "drop",
                      "unlink",
                      "relink",
                      "duplicate",
                      "corrupt",
                      "resign"
                    ]
                  },
                  "index": { "type": "integer", "minimum": 0 },
                  "path": { "type": "string", "minLength": 1 },
                  "value": {},
                  "to": { "type": "integer", "minimum": 0 },
                  "seed_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "kid": { "type": "string", "minLength": 1 }
                },
                "allOf": [
                  {
                    "if": { "properties": { "op": { "const": "edit_and_rehash" } } },
                    "then": { "required": ["path", "value"] }
                  },
                  {
                    "if": { "properties": { "op": { "const": "relink" } } },
                    "then": { "required": ["to"] }
                  },
                  {
                    "if": { "properties": { "op": { "const": "resign" } } },
                    "then": { "required": ["seed_hex", "kid"] }
                  }
                ]
              }
            }
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "approver", "approved_at"],
            "properties": {
              "capability": { "type": "string" },
              "approver": {
                "type": "object",
                "required": ["type", "id"],
                "properties": {
                  "type": { "type": "string" },
                  "id": { "type": "string" }
                }
              },
              "approved_at": { "type": "string", "format": "date-time" },
              "context": { "type": "object" }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["actor", "agent", "tool", "target", "arguments"],
      "additionalProperties": false,
      "properties": {
        "actor": { "type": "object" },
        "agent": { "type": "object" },
        "tool": { "type": "object" },
        "target": { "type": "object" },
        "arguments": { "type": "object" },
        "executed_arguments": {
          "type": "object",
          "description": "Arguments the agent submitted at execution when they differ from the ones policy evaluated (an agent that changed them after approval)."
        },
        "envelope_inject": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op"],
            "additionalProperties": false,
            "properties": {
              "op": {
                "type": "string",
                "enum": ["resign_with_alg", "non_canonical_payload", "replace_in_payload"]
              },
              "alg": { "type": "integer" },
              "find": { "type": "string", "minLength": 1 },
              "replace": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "op": { "const": "resign_with_alg" } } },
                "then": { "required": ["alg"] }
              },
              {
                "if": { "properties": { "op": { "const": "replace_in_payload" } } },
                "then": { "required": ["find", "replace"] }
              }
            ]
          }
        },
        "inject": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "omit_field",
                  "mutate_field",
                  "tamper_arguments_hash",
                  "tamper_receipt_hash"
                ]
              },
              "path": { "type": "string" },
              "value": {},
              "after": { "type": "string", "enum": ["emit"] },
              "recompute_hash": { "type": "boolean" }
            }
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["allow", "deny", "require-approval", "escalate"]
        },
        "conformance_level": { "type": "integer", "minimum": 1, "maximum": 4 },
        "receipt_must_validate": { "type": "boolean" },
        "failures_must_include": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "equals"],
            "properties": {
              "field": { "type": "string" },
              "equals": {}
            }
          }
        }
      }
    }
  }
}
